config {
  type: "table",
  schema: "STG_BIOGRID_ACTIVOS_ELECTRICOS",
  name: "STG_TRANSMISSION_LINES",
  description: "Tramos de lineas de transmision tipados, normalizados y validados geoespacialmente.",
  tags: ["ACTIVOS_ELECTRICOS", "STG"],
  assertions: {
    uniqueKey: ["ASSET_KEY"],
    nonNull: ["ASSET_KEY", "SOURCE_OBJECT_ID", "ASSET_NAME", "SOURCE_LAYER", "INGESTED_AT"]
  },
  bigquery: {
    clusterBy: ["OWNER_NAME", "TRANSMISSION_TYPE", "VOLTAGE_KV"]
  }
}

WITH SOURCE_DATA AS (
  SELECT
    CAST(source_object_id AS STRING) AS SOURCE_OBJECT_ID,
    CAST(line_id AS STRING) AS LINE_ID,
    CAST(subtype_id AS STRING) AS SUBTYPE_ID,
    NULLIF(REGEXP_REPLACE(TRIM(CAST(name AS STRING)), r'\s+', ' '), '') AS ASSET_NAME_RAW,
    NULLIF(UPPER(TRIM(CAST(circuit AS STRING))), '') AS CIRCUIT,
    NULLIF(UPPER(TRIM(CAST(transmission_type AS STRING))), '') AS TRANSMISSION_TYPE_RAW,
    SAFE_CAST(length_km AS NUMERIC) AS LENGTH_KM_SOURCE,
    NULLIF(REGEXP_REPLACE(TRIM(CAST(stretch AS STRING)), r'\s+', ' '), '') AS STRETCH_RAW,
    NULLIF(REGEXP_REPLACE(TRIM(CAST(owner AS STRING)), r'\s+', ' '), '') AS OWNER_NAME_RAW,
    SAFE_CAST(voltage_kv AS NUMERIC) AS VOLTAGE_KV,
    NULLIF(TRIM(CAST(environmental_resolution AS STRING)), '') AS ENVIRONMENTAL_RESOLUTION_RAW,
    NULLIF(TRIM(CAST(electrical_system AS STRING)), '') AS ELECTRICAL_SYSTEM_RAW,
    NULLIF(TRIM(CAST(status AS STRING)), '') AS STATUS_RAW,
    NULLIF(UPPER(TRIM(CAST(region AS STRING))), '') AS REGION_NAME,
    NULLIF(UPPER(TRIM(CAST(province AS STRING))), '') AS PROVINCE_NAME,
    NULLIF(UPPER(TRIM(CAST(commune AS STRING))), '') AS COMMUNE_NAME,
    NULLIF(UPPER(TRIM(CAST(base_source AS STRING))), '') AS SOURCE_SYSTEM,
    DATE(SAFE_CAST(operation_date AS TIMESTAMP)) AS OPERATION_DATE,
    SAFE_CAST(source_created_at AS TIMESTAMP) AS SOURCE_CREATED_AT,
    SAFE_CAST(source_updated_at AS TIMESTAMP) AS SOURCE_UPDATED_AT,
    UPPER(TRIM(CAST(source_layer AS STRING))) AS SOURCE_LAYER,
    SAFE_CAST(ingested_at AS TIMESTAMP) AS INGESTED_AT,
    ST_ASTEXT(geometry) AS GEOMETRY_WKT,
    geometry AS GEOGRAPHY
  FROM ${ref("transmission_lines")}
),

STANDARDIZED AS (
  SELECT
    CONCAT('TRANSMISSION_LINE|', SOURCE_OBJECT_ID) AS ASSET_KEY,
    SOURCE_OBJECT_ID,
    LINE_ID,
    SUBTYPE_ID,
    UPPER(ASSET_NAME_RAW) AS ASSET_NAME,
    UPPER(COALESCE(TRANSMISSION_TYPE_RAW, 'DESCONOCIDO')) AS TRANSMISSION_TYPE,
    CIRCUIT,
    LENGTH_KM_SOURCE,
    UPPER(STRETCH_RAW) AS STRETCH,
    UPPER(OWNER_NAME_RAW) AS OWNER_NAME,
    VOLTAGE_KV,
    COALESCE(CONCAT(REPLACE(CAST(VOLTAGE_KV AS STRING), '.', '_'), '_KV'), 'DESCONOCIDO') AS VOLTAGE_CATEGORY,
    NULLIF(UPPER(ENVIRONMENTAL_RESOLUTION_RAW), 'S/I') AS ENVIRONMENTAL_RESOLUTION,
    UPPER(COALESCE(ELECTRICAL_SYSTEM_RAW, 'DESCONOCIDO')) AS ELECTRICAL_SYSTEM,
    CASE
      WHEN UPPER(STATUS_RAW) IN ('OPERATIVA', 'EN OPERACION', 'EN OPERACIÓN') THEN 'EN_OPERACION'
      WHEN STATUS_RAW IS NULL OR UPPER(STATUS_RAW) = 'S/I' THEN 'DESCONOCIDO'
      ELSE REGEXP_REPLACE(UPPER(STATUS_RAW), r'[^A-Z0-9]+', '_')
    END AS OPERATIONAL_STATUS,
    REGION_NAME,
    PROVINCE_NAME,
    COMMUNE_NAME,
    SOURCE_SYSTEM,
    OPERATION_DATE,
    SOURCE_CREATED_AT,
    SOURCE_UPDATED_AT,
    SOURCE_LAYER,
    INGESTED_AT,
    GEOMETRY_WKT,
    GEOGRAPHY,
    IF(GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_LineString', ST_LENGTH(GEOGRAPHY) / 1000, NULL) AS LENGTH_KM_CALCULATED,
    IF(GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_LineString', ST_STARTPOINT(GEOGRAPHY), NULL) AS START_POINT,
    IF(GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_LineString', ST_ENDPOINT(GEOGRAPHY), NULL) AS END_POINT,
    IF(GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_LineString', ST_CENTROID(GEOGRAPHY), NULL) AS REFERENCE_POINT
  FROM SOURCE_DATA
)

SELECT
  * EXCEPT (GEOMETRY_WKT),
  GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_LineString' AS IS_VALID_GEOMETRY,
  CASE
    WHEN GEOGRAPHY IS NULL OR ST_GEOMETRYTYPE(GEOGRAPHY) != 'ST_LineString' THEN 'GEOMETRIA_INVALIDA'
    WHEN OWNER_NAME IS NULL THEN 'PROPIETARIO_NO_INFORMADO'
    WHEN LENGTH_KM_SOURCE IS NULL THEN 'LONGITUD_NO_INFORMADA'
    ELSE 'VALIDO'
  END AS DATA_QUALITY_STATUS,
  TO_HEX(SHA256(TO_JSON_STRING(STRUCT(
    LINE_ID, ASSET_NAME, OWNER_NAME, VOLTAGE_KV, TRANSMISSION_TYPE,
    CIRCUIT, LENGTH_KM_SOURCE, STRETCH, OPERATIONAL_STATUS,
    REGION_NAME, PROVINCE_NAME, COMMUNE_NAME, OPERATION_DATE, GEOMETRY_WKT
  )))) AS SOURCE_RECORD_HASH,
  CURRENT_TIMESTAMP() AS PROCESSED_AT
FROM STANDARDIZED
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY ASSET_KEY
  ORDER BY SOURCE_UPDATED_AT DESC NULLS LAST, INGESTED_AT DESC, SOURCE_CREATED_AT DESC NULLS LAST
) = 1