config {
  type: "table",
  schema: "STG_BIOGRID_ACTIVOS_ELECTRICOS",
  name: "STG_SUBSTATIONS",
  description: "Subestaciones electricas tipadas, normalizadas y validadas geoespacialmente.",
  tags: ["ACTIVOS_ELECTRICOS", "STG"],
  assertions: {
    uniqueKey: ["ASSET_KEY"],
    nonNull: ["ASSET_KEY", "SOURCE_OBJECT_ID", "ASSET_NAME", "SOURCE_LAYER", "INGESTED_AT"]
  },
  bigquery: {
    clusterBy: ["REGION_CODE", "OWNER_NAME", "OPERATIONAL_STATUS"]
  }
}

WITH SOURCE_DATA AS (
  SELECT
    CAST(source_object_id AS STRING) AS SOURCE_OBJECT_ID,
    CAST(substation_id AS STRING) AS SUBSTATION_ID,
    CAST(subtype_id AS STRING) AS SUBTYPE_ID,
    NULLIF(REGEXP_REPLACE(TRIM(CAST(name AS STRING)), r'\s+', ' '), '') AS ASSET_NAME_RAW,
    NULLIF(REGEXP_REPLACE(TRIM(CAST(owner AS STRING)), r'\s+', ' '), '') AS OWNER_NAME_RAW,
    NULLIF(TRIM(CAST(voltage_kv AS STRING)), '') AS VOLTAGE_RAW,
    NULLIF(TRIM(CAST(substation_type AS STRING)), '') AS SUBSTATION_TYPE_RAW,
    NULLIF(TRIM(CAST(environmental_resolution AS STRING)), '') AS ENVIRONMENTAL_RESOLUTION_RAW,
    NULLIF(TRIM(CAST(electrical_system AS STRING)), '') AS ELECTRICAL_SYSTEM_RAW,
    NULLIF(TRIM(CAST(status AS STRING)), '') AS STATUS_RAW,
    SAFE_CAST(source_easting AS FLOAT64) AS SOURCE_EASTING,
    SAFE_CAST(source_northing AS FLOAT64) AS SOURCE_NORTHING,
    NULLIF(UPPER(TRIM(CAST(source_utm_zone AS STRING))), '') AS SOURCE_UTM_ZONE,
    NULLIF(UPPER(TRIM(CAST(source_datum AS STRING))), '') AS SOURCE_DATUM,
    LPAD(NULLIF(TRIM(CAST(region AS STRING)), ''), 2, '0') AS REGION_CODE,
    LPAD(NULLIF(TRIM(CAST(province AS STRING)), ''), 3, '0') AS PROVINCE_CODE,
    LPAD(NULLIF(TRIM(CAST(commune AS STRING)), ''), 5, '0') AS COMMUNE_CODE,
    NULLIF(UPPER(TRIM(CAST(base_source AS STRING))), '') AS SOURCE_SYSTEM,
    DATE(SAFE_CAST(operation_date AS TIMESTAMP)) AS OPERATION_DATE,
    SAFE_CAST(source_created_at AS TIMESTAMP) AS SOURCE_CREATED_AT,
    SAFE_CAST(source_updated_at AS TIMESTAMP) AS SOURCE_UPDATED_AT,
    UPPER(TRIM(CAST(source_layer AS STRING))) AS SOURCE_LAYER,
    SAFE_CAST(ingested_at AS TIMESTAMP) AS INGESTED_AT,
    ST_ASTEXT(geometry) AS GEOMETRY_WKT,
    geometry AS GEOGRAPHY
  FROM ${ref("substations")}
),

STANDARDIZED AS (
  SELECT
    CONCAT('SUBSTATION|', SOURCE_OBJECT_ID) AS ASSET_KEY,
    SOURCE_OBJECT_ID,
    SUBSTATION_ID,
    SUBTYPE_ID,
    UPPER(ASSET_NAME_RAW) AS ASSET_NAME,
    ASSET_NAME_RAW,
    UPPER(OWNER_NAME_RAW) AS OWNER_NAME,
    OWNER_NAME_RAW,
    VOLTAGE_RAW,
    CASE
      WHEN STARTS_WITH(VOLTAGE_RAW, '<') THEN NULL
      ELSE SAFE_CAST(REPLACE(VOLTAGE_RAW, ',', '.') AS NUMERIC)
    END AS VOLTAGE_KV,
    CASE
      WHEN STARTS_WITH(VOLTAGE_RAW, '<') THEN CONCAT('MENOR_A_', REGEXP_EXTRACT(VOLTAGE_RAW, r'[0-9]+(?:[.,][0-9]+)?'), '_KV')
      WHEN SAFE_CAST(REPLACE(VOLTAGE_RAW, ',', '.') AS NUMERIC) IS NOT NULL THEN CONCAT(REPLACE(VOLTAGE_RAW, '.', '_'), '_KV')
      ELSE 'DESCONOCIDO'
    END AS VOLTAGE_CATEGORY,
    UPPER(COALESCE(SUBSTATION_TYPE_RAW, 'DESCONOCIDO')) AS ASSET_CATEGORY,
    NULLIF(UPPER(ENVIRONMENTAL_RESOLUTION_RAW), 'S/I') AS ENVIRONMENTAL_RESOLUTION,
    UPPER(COALESCE(ELECTRICAL_SYSTEM_RAW, 'DESCONOCIDO')) AS ELECTRICAL_SYSTEM,
    CASE
      WHEN UPPER(STATUS_RAW) IN ('OPERATIVA', 'EN OPERACION', 'EN OPERACIÓN') THEN 'EN_OPERACION'
      WHEN STATUS_RAW IS NULL OR UPPER(STATUS_RAW) = 'S/I' THEN 'DESCONOCIDO'
      ELSE REGEXP_REPLACE(UPPER(STATUS_RAW), r'[^A-Z0-9]+', '_')
    END AS OPERATIONAL_STATUS,
    STATUS_RAW,
    SOURCE_EASTING,
    SOURCE_NORTHING,
    SOURCE_UTM_ZONE,
    SOURCE_DATUM,
    REGION_CODE,
    PROVINCE_CODE,
    COMMUNE_CODE,
    SOURCE_SYSTEM,
    OPERATION_DATE,
    SOURCE_CREATED_AT,
    SOURCE_UPDATED_AT,
    SOURCE_LAYER,
    INGESTED_AT,
    GEOMETRY_WKT,
    GEOGRAPHY,
    IF(GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_Point', ST_X(GEOGRAPHY), NULL) AS LONGITUDE,
    IF(GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_Point', ST_Y(GEOGRAPHY), NULL) AS LATITUDE
  FROM SOURCE_DATA
)

SELECT
  * EXCEPT (ASSET_NAME_RAW, OWNER_NAME_RAW, STATUS_RAW, GEOMETRY_WKT),
  GEOGRAPHY IS NOT NULL AND ST_GEOMETRYTYPE(GEOGRAPHY) = 'ST_Point' AS IS_VALID_GEOMETRY,
  CASE
    WHEN GEOGRAPHY IS NULL OR ST_GEOMETRYTYPE(GEOGRAPHY) != 'ST_Point' THEN 'GEOMETRIA_INVALIDA'
    WHEN OWNER_NAME IS NULL THEN 'PROPIETARIO_NO_INFORMADO'
    ELSE 'VALIDO'
  END AS DATA_QUALITY_STATUS,
  TO_HEX(SHA256(TO_JSON_STRING(STRUCT(
    SUBSTATION_ID, ASSET_NAME, OWNER_NAME, VOLTAGE_RAW, ASSET_CATEGORY,
    OPERATIONAL_STATUS, REGION_CODE, PROVINCE_CODE, COMMUNE_CODE,
    OPERATION_DATE, GEOMETRY_WKT
  )))) AS SOURCE_RECORD_HASH,
  CURRENT_TIMESTAMP() AS PROCESSED_AT
FROM STANDARDIZED
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY ASSET_KEY
  ORDER BY SOURCE_UPDATED_AT DESC NULLS LAST, INGESTED_AT DESC, SOURCE_CREATED_AT DESC NULLS LAST
) = 1
