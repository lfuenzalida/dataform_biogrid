config {
  type: "table",
  schema: "DEL_BIODIVERSIDAD_STGO",
  description: "Capa Delivery: Tabla unificada y particionada con indexación geoespacial para consumo de la App Web",
  bigquery: {
    partitionBy: "DATE(FECHA_AVISTAMIENTO)",
    clusterBy: ["ORIGEN_DATOS"] 
  }
}

WITH union_fuentes AS (
    -- Bloque eBird
    SELECT 
        ID_INTEGRACION, ID_ORIGEN, ORIGEN_DATOS, NOMBRE_CIENTIFICO, 
        CAST(NULL AS STRING) AS REINO, CAST(NULL AS STRING) AS FAMILIA, CAST(NULL AS STRING) AS GENERO,
        LATITUD, LONGITUD, FECHA_AVISTAMIENTO, CAST(NULL AS STRING) AS GRADO_AMENAZA
    FROM ${ref("STG_BIODIVERSIDAD_STGO", "STG_EBIRD")}
    
    UNION ALL
    
    -- Bloque iNaturalist
    SELECT 
        ID_INTEGRACION, ID_ORIGEN, ORIGEN_DATOS, NOMBRE_CIENTIFICO, 
        REINO, CAST(NULL AS STRING) AS FAMILIA, CAST(NULL AS STRING) AS GENERO,
        LATITUD, LONGITUD, FECHA_AVISTAMIENTO, GRADO_AMENAZA
    FROM ${ref("STG_BIODIVERSIDAD_STGO", "STG_INATURALIST")}
    
    UNION ALL
    
    -- Bloque GBIF
    SELECT 
        ID_INTEGRACION, ID_ORIGEN, ORIGEN_DATOS, NOMBRE_CIENTIFICO, 
        REINO, FAMILIA, GENERO,
        LATITUD, LONGITUD, FECHA_AVISTAMIENTO, GRADO_AMENAZA
    FROM ${ref("STG_BIODIVERSIDAD_STGO", "STG_GBIF")}
)

SELECT 
    *,
    ST_GEOGPOINT(LONGITUD, LATITUD) AS PUNTO_GEOESPACIAL
FROM 
    union_fuentes